{
  "manifest_version": 3,
  "name": "MarketMind",
  "version": "1.0",
  "description": "Enhanced Facebook Marketplace browsing experience with viewed item tracking",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://*.facebook.com/marketplace/*"],
    "js": ["content.js"],
    "css": ["styles.css"]
  }],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["stats.html", "stats.css", "stats.js", "panel.html", "panel.js"],
      "matches": ["<all_urls>"]
    }
  ]
} 